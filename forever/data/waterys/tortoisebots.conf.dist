#############################################
# TortoiseBots Configuration file (Forever) #
#############################################
# Generated from config-knobs.csv (TB aiplayerbot.conf.dist.in classified).
# Every `Key = value` line shows the Forever default.
# CARRY_OVER ports unchanged; NEW_DEFAULT_NEEDED carries the suggested Forever value
# (marked SUGGESTED where the source data, not live testing, sets it).

[TortoiseBotsConf]

# --- Enabled ---
# on/off switch, not an id; ports unchanged
AiPlayerbot.Enabled = 1

# --- Observability ---
# generic bot behaviour/timing/threshold; ports unchanged
AiPlayerbot.Observability = 1

# --- AhBot ---
# generic bot behaviour/timing/threshold; ports unchanged
AiPlayerbot.AhBot.AccountName = TBAHBOT
# generic bot behaviour/timing/threshold; ports unchanged
AiPlayerbot.AhBot.SellersPerFaction = 4
# generic bot behaviour/timing/threshold; ports unchanged
AiPlayerbot.AhBot.SellerRepairIntervalSeconds = 300
# on/off switch, not an id; ports unchanged
AiPlayerbot.AhBot.ListedItemLevelRestrict.Enabled = 0
