[tortoisebots]

#
#    TortoiseBots.Enable
#        Description: Master switch. 0 = the module loads but does nothing and its commands refuse.
#        Default:     0
#

TortoiseBots.Enable = 0

#
#    TortoiseBots.Spike.FollowDistance
#        Description: How far behind its master a bot stands, in yards.
#        Default:     3
#

TortoiseBots.Spike.FollowDistance = 3

#
#    TortoiseBots.ClassQuestSpells
#        Description: Bots learn the class spells a real player gets from its class quests (Summon Imp, the warrior stances,
#                     the hunter pet kit, the priest racials, the druid forms and the shaman totems) when they log in and when
#                     they gain a level. Only spells from the module's reviewed list are taught, and only through a class
#                     quest the running world has. 0 = no index at startup and no bot is touched.
#        Default:     0 (test servers turn it on)
#

TortoiseBots.ClassQuestSpells = 0

#
#    TortoiseBots.Slice.EngineByDefault
#        Description: A bot that logs in runs on the real bot engine (PlayerbotAI) instead of the spike's follow/assist.
#                     Only has an effect in a build made with TORTOISEBOTS_SLICE1. `.tb engine <character> on|off`
#                     changes it for one bot that is already logged in.
#        Default:     0
#

TortoiseBots.Slice.EngineByDefault = 0

#
#    TortoiseBots.Slice.MasterGraceSeconds
#        Description: How long a bot waits when its master logs out. The bot stays in the world and in its party, stops acting, and follows
#                     again when the master is back in the world within this time; after it the bot logs out. 0 = the bots log out with
#                     their master at once. Capped at 3600.
#        Default:     300 (the hire lifecycle's own default: AiPlayerbot.HireDisconnectGracePeriod)
#

TortoiseBots.Slice.MasterGraceSeconds = 300

#
#    TortoiseBots.Slice.DeadBackstopSeconds
#        Description: How long a commanded bot's body may lie in a dungeon (nothing raising it, its commander away, a hold that never ends)
#                     before the bot releases itself and comes back at the dungeon's entrance. 10 to 3600.
#        Default:     180
#

TortoiseBots.Slice.DeadBackstopSeconds = 180

#
#    Logger.tortoisebots
#        Description: The module's own log category (bot login and logout, the engine, the `slice: missing ...` lines).
#                     Without a logger of its own the category falls to the root logger, which only logs errors, so the
#                     module's information and warning lines would not appear at all. Level 3 = info (1 trace, 2 debug,
#                     3 info, 4 warn, 5 error). The appenders are the ones of the stock worldserver.conf.
#        Default:     3
#

Logger.tortoisebots = 3,Console Server

#
#    TortoiseBots.Slice.RestHealthPct
#        Description: The rest gate of `.tb state` (resting=no): a bot is rested when its health is at or above this percent of its maximum
#                     (and, for a bot that uses mana, its mana is at or above TortoiseBots.Slice.RestManaPct, and it is not in combat,
#                     eating or drinking). Read on every `.tb state`, so a change by a config reload counts at once. 0 to 100.
#        Default:     90
#

TortoiseBots.Slice.RestHealthPct = 90

#
#    TortoiseBots.Slice.RestManaPct
#        Description: The mana part of the rest gate (see TortoiseBots.Slice.RestHealthPct). Bots that do not use mana ignore it. 0 to 100.
#        Default:     80
#

TortoiseBots.Slice.RestManaPct = 80

#
#    TortoiseBots.Commander.KeepBindings
#        Description: Keep a commander binding (`.tb master party <lead> <commander>`) across a worldserver restart, in the characters-database
#                     table `tb_commander_binding` (forever/sql/characters/2026_11_20_00_tb_commander_binding.sql; the module creates it when this key
#                     is 1 and the database user may). Rows store character guids only, never a group number. When the commander and the lead are back
#                     in the world, the party is re-formed through the lead and every member is bound to the commander again. 0 = nothing is written
#                     and nothing is read (the binding lives in memory, as before).
#        Default:     0
#

TortoiseBots.Commander.KeepBindings = 0

#
#    TortoiseBots.Commander.Feeds
#        Description: Send the Commander card's map layers (the hostile units near the binding's lead, the game objects its bots have near them,
#                     the known bosses of its lead's dungeon with their state, and what each bot is doing: cast, crowd control, rest, target, the boss
#                     debuffs it carries, the ready check) in the dashboard's COMMANDERS report. Only in the engine build and only while a binding
#                     stands; a layer whose scan did not run is sent as null, never as an empty list. 0 = the card keeps the layers greyed out.
#        Default:     1
#

TortoiseBots.Commander.Feeds = 1

#
#    TortoiseBots.Commander.MobRange
#    TortoiseBots.Commander.ObjectRange
#        Description: The radius in yards of the two sweeps around a binding's lead bot: the hostile units listed for the card (the nearest 24) and
#                     the doors, chests, levers, goobers and rituals its bots have near them (the nearest 16). 1 to 200.
#        Default:     60, 40
#

TortoiseBots.Commander.MobRange = 60
TortoiseBots.Commander.ObjectRange = 40

#
#    TortoiseBots.Commander.PosMs
#        Description: How often the live position report (COMMANDER_POS) goes out for every standing binding: where its bots are, the enemies its
#                     last COMMANDERS report listed. Field reads only, no scan. 50 to 2000; the dashboard merges the reports between the 2 s cards.
#        Default:     100
#

TortoiseBots.Commander.PosMs = 100

#
#    TortoiseBots.Orders.Tactical
#        Description: The tactical orders of `.tb order` and `.tb cmd`: stop, flee, guard, stance, engage and rebuff. At 0 every one
#                     of them answers `error code=disabled` and nothing is queued; the engine still runs an order that was queued before the
#                     switch went off. Read on each use, so a config reload counts at once.
#        Default:     1
#

TortoiseBots.Orders.Tactical = 1

#
#    TortoiseBots.Dashboard.Enable
#        Description: Send the bot roster to the TortoiseBots dashboard (tools/observability) over UDP. Only while TortoiseBots.Enable = 1.
#        Default:     1
#

TortoiseBots.Dashboard.Enable = 1

#
#    TortoiseBots.Dashboard.Host
#    TortoiseBots.Dashboard.Port
#        Description: Where the dashboard listens for telemetry (its -udp-host / -udp-port). The host may be an IP address
#                     or a host name, such as a dashboard container's name; a name is resolved when the config loads.
#        Default:     127.0.0.1, 9195
#

TortoiseBots.Dashboard.Host = "127.0.0.1"
TortoiseBots.Dashboard.Port = 9195

#
#    TortoiseBots.Dashboard.IntervalMs
#        Description: How often the roster is sent, in milliseconds (at least 500).
#        Default:     2000
#

TortoiseBots.Dashboard.IntervalMs = 2000

#
#    TortoiseBots.Dashboard.ItemsFile
#    TortoiseBots.Dashboard.UiMapsFile
#    TortoiseBots.Dashboard.SpellsFile
#    TortoiseBots.Dashboard.TalentsFile
#    TortoiseBots.Dashboard.NamesFile
#        Description: Where the module writes the data tables the dashboard reads (items, world maps, spells, talents,
#                     names), at world start. Empty = <LogsDir>/tortoisebots-items.json, -uimaps.json, -spells.json,
#                     -talents.json, -names.json. Point the dashboard's -data-dir at that folder.
#        Default:     ""
#

TortoiseBots.Dashboard.ItemsFile = ""
TortoiseBots.Dashboard.UiMapsFile = ""
TortoiseBots.Dashboard.SpellsFile = ""
TortoiseBots.Dashboard.TalentsFile = ""
TortoiseBots.Dashboard.NamesFile = ""

#
#    TortoiseBots.Dashboard.Runs
#        Description: Send the dungeon runs (`.tb run`) to the dashboard's Commander tab (one COMMANDERS datagram per cycle, one binding per
#                     run). Only in the engine build, and only while TortoiseBots.Dashboard.Enable = 1.
#        Default:     1
#

TortoiseBots.Dashboard.Runs = 1

#
#    TortoiseBots.Dashboard.RunSummaryDir
#        Description: The folder where a finished run writes its `<run>.summary.json` for the dashboard's Dungeon runs tab. Point the dashboard's
#                     -trace-dir (TBDASH_TRACE_DIR) at the same folder; created when missing. Empty = no summary files.
#        Default:     ""
#

TortoiseBots.Dashboard.RunSummaryDir = ""

#
#    TortoiseBots.World.Professions
#        Description: Allow free bots (`free`) to gather herb/ore nodes within 150 yd in the current zone.
#        Default:     0
#

TortoiseBots.World.Professions = 0

#
#    TortoiseBots.World.Auction
#        Description: Allow bots to use the faction auction house (`.tb order ... ah`).
#        Default:     0
#

TortoiseBots.World.Auction = 0

#
#    TortoiseBots.World.GroupQuests
#        Description: Allow nearby free bots holding the same group or elite quest to form a party and disband when done.
#        Default:     1
#

TortoiseBots.World.GroupQuests = 1

#
#    TortoiseBots.World.CapitalErrands
#        Description: Allow free bots (`free`) in a capital to occasionally run mailbox, trainer, bank, and AH errands,
#                     and challenge/accept bot-vs-bot duels in dueling areas (city gates). Also lets a free bot within
#                     150 yd of a riding trainer or its race's mount vendor learn riding and buy the mount with its own
#                     gold (normal at 40, epic at 60); nothing is granted.
#        Default:     1
#

TortoiseBots.World.CapitalErrands = 1

#
#    TortoiseBots.World.GuildMail
#        Description: Allow free bots in a bot guild to mail surplus gold to the poorest online bot member and unused
#                     crafting materials to online bot crafters who use them. Never mails real players' items or gold.
#        Default:     1
#

TortoiseBots.World.GuildMail = 1

#
#    TortoiseBots.World.GuildMail.AllowMixedGuild
#        Description: When TortoiseBots.World.GuildMail = 1, allow bots in guilds that also contain real players to
#                     exchange guild mail with other bot members (real players are still never mailed or touched).
#        Default:     0
#

TortoiseBots.World.GuildMail.AllowMixedGuild = 0

#
#    TortoiseBots.World.GuildOrderBotRank
#        Description: Guild orders: give every module-owned bot in a guild that also has a real player one shared
#                     guild rank, so the master can open guild bank tabs to it (`.tb guildorder rank <rank>`).
#                     Off: ranks are never changed and `.tb guildorder access` reports that no rank is managed.
#        Default:     1
#

TortoiseBots.World.GuildOrderBotRank = 1

#
#    TortoiseBots.World.Pickpocket
#        Description: Allow free and pool rogue bots that know Stealth and Pick Pocket to sneak up on a nearby
#                     humanoid whose pockets are not empty yet, pick them, and take the loot (coins and items).
#                     A creature whose pockets were just picked is not retried before its own refill timer.
#                     Bots without the two spells are skipped; no class spell is granted for this.
#        Default:     1
#

TortoiseBots.World.Pickpocket = 1

#
#    TortoiseBots.World.Lockboxes
#        Description: Allow free and pool rogue bots with enough Lockpicking to open the lockboxes in their own bags
#                     (Pick Lock, then open and take the loot).
#        Default:     1
#

TortoiseBots.World.Lockboxes = 1

#
#    TortoiseBots.World.LockboxMail
#        Description: Allow a bot holding a lockbox it cannot open (not a rogue, no Pick Lock, or Lockpicking too low)
#                     to mail it to the best rogue bot in its own guild (online or offline), which opens it and mails
#                     the contents, coins minus the return postage, back to the sender. Only bots are served and only
#                     bots are mailed; a real player's mail is never taken. With no capable rogue the box stays put.
#        Default:     1
#

TortoiseBots.World.LockboxMail = 1

#
#    TortoiseBots.Dashboard.TraceDir
#        Description: Where the module writes a summary of every dungeon or raid run with bots (bosses killed and when,
#                     wipes, deaths, party, outcome) for the dashboard's Dungeon runs tab. Empty = <LogsDir>/runs.
#                     Point the dashboard's -trace-dir (TBDASH_TRACE_DIR) at it.
#        Default:     ""
#

TortoiseBots.Dashboard.TraceDir = ""

#
#    --- W0 pool (FOREVER-W0-W4-SPEC.md, round W0-A) ---
#
#    TortoiseBots.Pool.Enable
#        Description: The bot pool: a set of level-1 characters the module creates itself and logs in as free bots on a schedule.
#                     Off by default. With the key on but its tables missing, the pool is off and one error line names
#                     forever/sql/characters/2026_11_20_01_tb_pool.sql. The schedule itself starts only with `.tb pool start`.
#        Default:     0
#

TortoiseBots.Pool.Enable = 0

#
#    TortoiseBots.Pool.CreatePerMinute
#        Description: How many pool characters `.tb pool create <n>` may make per minute (one per world tick at most, never a burst).
#                     0 = nothing may be created. 1 to 600.
#        Default:     30
#

TortoiseBots.Pool.CreatePerMinute = 30

#
#    TortoiseBots.Pool.MaxCharacters
#        Description: The ceiling on the pool's total size: characters already made plus the ones being created. `.tb pool create`
#                     refuses when the pool is at the cap and creates only what still fits when it asks for more. The per-command
#                     count alone does not bound the table: the pool cannot grow past this number. 0 = nothing may be created.
#        Default:     50
#

TortoiseBots.Pool.MaxCharacters = 50

#
#    TortoiseBots.Pool.TargetOnline
#        Description: The pool's online target: `.tb pool start` keeps this many pool bots of both factions in the world (0 = the
#                     schedule runs but logs nobody in; sessions that end still log out). One session per account is the rule
#                     (the pool puts up to ten characters on an account), so the online count is capped by the number of accounts
#                     the pool's characters sit on. A bot that got a master keeps its account for as long as the binding lasts,
#                     and the pool cannot end it: that account is out of reach, so the pool needs more accounts than the target to
#                     refill the slot of a bound bot. `.tb pool status` adds `capped by accounts: N` when the target is above the
#                     accounts left. Logins alternate factions and take the bot offline longest first; a bot that got a master
#                     leaves the count. A lowered target logs out the newest sessions first, never a dead or fighting bot.
#                     0 to 5000.
#                     `.tb pool population <n|low|high>` changes the target at runtime; `.reload config` puts this value back.
#        Default:     0
#

TortoiseBots.Pool.TargetOnline = 0

#
#    TortoiseBots.Pool.LoginsPerMinute
#        Description: At most this many pool logins in any 60 s window, and at most one per second. 0 = no logins. 1 to 600.
#        Default:     20
#

TortoiseBots.Pool.LoginsPerMinute = 20

#
#    TortoiseBots.Pool.SessionMinutes.Min / .Max
#        Description: A pool bot's session lasts a length rolled uniformly between these, in minutes, decided when it logs in.
#                     A living bot in combat keeps its session until the fight ends (`.tb pool stop` is the exception).
#                     `.Max` below `.Min` reads as `.Min`. 0 to 1440.
#        Default:     Min 30, Max 90
#

TortoiseBots.Pool.SessionMinutes.Min = 30
TortoiseBots.Pool.SessionMinutes.Max = 90

#
#    TortoiseBots.Pool.OfflineMinutes.Min / .Max
#        Description: After its session a pool bot stays away for a length rolled uniformly between these, in minutes (written
#                     as `last_logout`). Only the login/logout stamps are stored: after a restart the minimum holds, so offline
#                     periods are shortened and every bot falls due together. `.Max` below `.Min` reads as `.Min`. 0 to 1440.
#                     A bot whose body is still there at its session's end (a corpse run) waits until it is alive again or 10 min.
#        Default:     Min 5, Max 20
#

TortoiseBots.Pool.OfflineMinutes.Min = 5
TortoiseBots.Pool.OfflineMinutes.Max = 20

#
#    TortoiseBots.Pool.PopulationLow / .PopulationHigh
#        Description: The two presets of `.tb pool population low|high`: a quiet and a busy online target, changed at runtime
#                     without touching TargetOnline. Each clamps to 0..5000 like TargetOnline.
#        Default:     Low 10, High 50
#

TortoiseBots.Pool.PopulationLow = 10
TortoiseBots.Pool.PopulationHigh = 50

#
#    --- Free bots: per-map cap ---
#
#    TortoiseBots.Free.MaxPerMap.Dungeon / .Raid10 / .Raid20 / .Raid40
#        Description: How many free bots one map of each kind holds: a dungeon takes the Dungeon cap, a raid the cap of its
#                     size (10, 20 or 40 by the map row's player count, unknown reads as 40). A free bot is refused entry
#                     (`.tb enter`, `.tb tele`, the follow catch-up) once its map is at the cap; commanded bots enter as a
#                     group of their own, under the core's group rules. 0 switches that kind off.
#        Default:     Dungeon 5, Raid10 10, Raid20 20, Raid40 40
#

TortoiseBots.Free.MaxPerMap.Dungeon = 5
TortoiseBots.Free.MaxPerMap.Raid10 = 10
TortoiseBots.Free.MaxPerMap.Raid20 = 20
TortoiseBots.Free.MaxPerMap.Raid40 = 40

#
#    TortoiseBots.Create.TestAccounts
#        Description: Accounts besides the pool's own (TBPOOL<nnnn>) that `.tb create <account> <name> <race> <class>` may put a
#                     character on, comma separated. Any other account is refused. `.tb create` needs the account-create right.
#        Default:     "" (pool accounts only)
#

TortoiseBots.Create.TestAccounts = ""

#
#    TortoiseBots.Run.GmObserver / TortoiseBots.Run.SelfRecover
#        Description: `.tb run start|pause|resume|stop` only. GmObserver lets a GM (SEC_GAMEMASTER) start, pause, resume and stop a run whose bots the
#                     ownership guard refuses, unless the commander chain from the bot reaches a real player (that player's party is never taken over).
#                     SelfRecover lets the host answer the policy's "N regroups by itself at this step did not hold" pause itself: the dead bots
#                     release their spirits and the run regroups again (revive wait, gather, rest, walk back), once per step and at most 3 times per
#                     run, never when a member is 400+ yd away or on another map. No teleport, no GM revive, no summon.
#        Default:     GmObserver 1, SelfRecover 1
#

TortoiseBots.Run.GmObserver = 1
TortoiseBots.Run.SelfRecover = 1

#
#    --- BG (BATTLEGROUNDS-SPEC.md, round BG1) ---
#
#    TortoiseBots.Bg.Enable
#        Description: The battleground round: fill a human's WSG/AB queue with pool bots, accept the bots' invitations, take them
#                     out of a queue that no longer wants them, let them leave a finished match and queue them at the area spirit
#                     healer after a death. Off by default (a big feature ships behind a toggle); with it off no hook does any
#                     work and no bot queues or accepts anything by itself.
#        Default:     0
#

TortoiseBots.Bg.Enable = 0

#
#    TortoiseBots.Bg.Maps
#        Description: The maps this round plays, comma separated: `wsg` (Warsong Gulch, map 489) and `ab` (Arathi Basin, map 529).
#                     AV, arenas and the random queue are out. A map whose flag stands / node banners or start locations are
#                     missing in the core's data is off with one error line at boot.
#        Default:     "wsg,ab"
#

TortoiseBots.Bg.Maps = "wsg,ab"

#
#    TortoiseBots.Bg.FillHumanQueues
#        Description: While a real player waits in a WSG/AB queue, queue free pool bots of that side's bracket and faction until
#                     each side has the module minimum below plus one, counting everyone already waiting. Both sides are filled
#                     (the human's own side first needs bots too). At most 5 bots per side per 5 s check. A side still short after
#                     180 s says so to the waiting player once: "not enough Horde bots for levels 10-19: 2 of 5".
#        Default:     1
#

TortoiseBots.Bg.FillHumanQueues = 1

#
#    TortoiseBots.Bg.Autonomous
#        Description: Bot-only battleground seeding (BG6): bots queue and play with no human in the match. In this round the
#                     creation veto reads it: with 0 a bracket holding only the module's bots never starts an instance; the seeder
#                     that keeps such a queue fed is BG6. Keep it 0.
#        Default:     0
#

TortoiseBots.Bg.Autonomous = 0

#
#    TortoiseBots.Bg.MinPlayersPerTeam
#        Description: The module's own match minimum per side. The core's BattlemasterList rows for 489/529 say 1 (R0), so a match
#                     would start at 1v1; the fill target is this plus one, clamped to the template's team size. 0 to 40.
#        Default:     5
#

TortoiseBots.Bg.MinPlayersPerTeam = 5

#
#    TortoiseBots.Bg.MaxInstancesWithBots
#        Description: At most this many battleground instances hold bots at once, counting the buckets a queued bot waits in as the
#                     instance it may become; a bot is not queued while the cap is reached.
#        Default:     2
#

TortoiseBots.Bg.MaxInstancesWithBots = 2

#
#    TortoiseBots.Bg.MaxBots
#        Description: At most this many bots are held for battlegrounds server-wide (queued, invited and inside all count); a bot is
#                     not queued while the cap is reached.
#        Default:     50
#

TortoiseBots.Bg.MaxBots = 50

#
#    TortoiseBots.Bg.MaxMinutes
#        Description: The longest a free bot stays inside one instance. At it the bot leaves without the Deserter debuff, so a
#                     `.tb pool stop` (which holds a bot in a battleground) can finish. A bound bot leaves with its human, or after
#                     60 s in an instance its human never reached.
#        Default:     45
#

TortoiseBots.Bg.MaxMinutes = 45

#    --- Player commands: `.bot` ---
#
#    TortoiseBots.Player.Commands
#        Description: The `.bot` command a player types in game (`.bot help`, `.bot who`, ...). 1 = players may use it;
#                     0 = only GameMasters may (a player is told `players-off`). Only the engine build has it
#                     (TORTOISEBOTS_SLICE1); without it `.bot` stays unknown to the core. `.tb` is a GameMaster command
#                     whatever this says.
#        Default:     1
#

TortoiseBots.Player.Commands = 1

#
#    TortoiseBots.Player.MaxBots
#        Description: How many of a player's own characters (on the player's Battle.net account) `.bot add` may put in the
#                     world at once, under the one-session-per-account rule. 0 to 4. Only the engine build has it.
#        Default:     4
#

TortoiseBots.Player.MaxBots = 4

#    --- Auto-learn ---
#
#    TortoiseBots.AutoLearnOnLevel
#        Description: Bots automatically learn their class trainer and class skill-line spells for free when they log in
#                     (catch-up) and when they gain a level. 0 = off (bots only learn spells when trained).
#        Default:     1
#

TortoiseBots.AutoLearnOnLevel = 1
#
#    TortoiseBots.AutoTalentsOnLevel
#        Description: Bots automatically spend their free talent points on login and on level-up following a premade spec build
#                     (honouring `.tb spec` if set, otherwise picking a stable weighted spec for the bot's guid, or keeping
#                     the bot's current tab once points are spent). Never resets existing points.
#        Default:     1
#

TortoiseBots.AutoTalentsOnLevel = 1
#    TortoiseBots.AutoProfessions
#        Description: Pool bots reaching level 5 automatically learn a class-sensible pair of primary professions plus
#                     First Aid and Cooking (and catch up on login if level >= 5 with no primary profession).

TortoiseBots.AutoProfessions = 1
#    TortoiseBots.AutoTools
#        Description: Automatically grant missing Classic profession tools (Mining Pick, Skinning Knife,
#                     Blacksmith Hammer, Fishing Pole, Arclight Spanner, Runed Copper Rod) into a free bag
#                     slot on login and level-up for pool and free bots. Never grants duplicates or touches
#                     real players or owned alts.

TortoiseBots.AutoTools = 1
#    TortoiseBots.AutoHunterPet
#        Description: Hunter bots at level 10 or higher with no pet out and none in their stable receive their race's
#                     starter pet and its pet spells on login and on level-up. Never replaces an existing pet.

TortoiseBots.AutoHunterPet = 1
#    TortoiseBots.AutoFood
#        Description: Pool and free bots receive level-fitting vendor food (and water for mana users) on login and level-up.

TortoiseBots.AutoFood = 1

#
#    AiPlayerbot.OwnedBotSummonCooldown (it lives in aiplayerbot.conf, not in this file)
#        Description: The wait between two `.bot summon <bot>`s of the same bot, in seconds (0 = no wait); capped at 3600. The key
#                     already belongs to the bot brain's config and that read stays the one that owns it: `.bot summon` reads the
#                     same key with the same default (300) and the same cap, so the two can never disagree. GameMasters are not
#                     held by the wait. The other AiPlayerbot.OwnedBotSummon* keys (WhenGroup, AllowInCombat, AllowMasterDead,
#                     AllowBotDead, Revive, Repair) are not read by `.bot summon`: its refusals are the shared `.tb tele` rules
#                     (combat, death, instances) plus the master and cooldown checks of the player command spec (D-8).
#        Default:     300
#
